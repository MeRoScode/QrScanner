<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/bnazaninbold"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_language"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/language"
        android:padding="10dp"
        android:src="@drawable/ic_language"
        app:layout_constraintBottom_toBottomOf="@+id/txv_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv_header"
        app:tint="@color/accent" />

    <ImageButton
        android:id="@+id/btn_rate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rate_app"
        android:padding="10dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@+id/btn_language"
        app:layout_constraintEnd_toStartOf="@+id/btn_language"
        app:layout_constraintTop_toTopOf="@+id/btn_language"
        app:tint="@color/accent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_scan"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/btn_accent"
        android:drawableStart="@drawable/ic_scan"
        android:drawablePadding="8dp"
        android:fontFamily="@font/bnazaninbold"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/scan_qr"
        android:textColor="@color/on_accent"
        android:textSize="17sp"
        app:layout_constraintEnd_toStartOf="@+id/btn_create_qr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_header" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_create_qr"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/btn_accent"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="8dp"
        android:fontFamily="@font/bnazaninbold"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/create_qr"
        android:textColor="@color/on_accent"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_scan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_scan"
        app:layout_constraintTop_toTopOf="@+id/btn_scan" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_scan_image"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_outline"
        android:drawableStart="@drawable/ic_image"
        android:drawablePadding="8dp"
        android:fontFamily="@font/bnazaninbold"
        android:gravity="center"
        android:text="@string/scan_from_image"
        android:textColor="@color/accent"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_scan" />

    <TextView
        android:id="@+id/txv_history_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/bnazaninbold"
        android:text="@string/history"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_scan_image" />

    <TextView
        android:id="@+id/btn_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:background="?attr/selectableItemBackground"
        android:padding="4dp"
        android:text="@string/clear_all"
        android:textColor="@color/accent"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/txv_history_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txv_history_label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rec"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/banner_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txv_history_label" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rec"
        app:layout_constraintEnd_toEndOf="@+id/rec"
        app:layout_constraintStart_toStartOf="@+id/rec"
        app:layout_constraintTop_toTopOf="@+id/rec">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_scan"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/empty_history"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Ad banner (Tapsell 320x50). Stays gone until an ad is actually shown. -->
    <FrameLayout
        android:id="@+id/banner_bottom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
